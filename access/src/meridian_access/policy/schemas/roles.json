{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["birthright", "roles"],
  "properties": {
    "birthright": {
      "type": "object",
      "additionalProperties": false,
      "required": ["employee", "contractor"],
      "properties": {
        "employee": {"$ref": "#/$defs/ids"},
        "contractor": {"$ref": "#/$defs/ids"}
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "department", "sso_apps", "other_apps"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "department": {"type": "string", "minLength": 1},
          "sso_apps": {"$ref": "#/$defs/ids"},
          "other_apps": {"$ref": "#/$defs/ids"}
        }
      }
    }
  },
  "$defs": {
    "ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
