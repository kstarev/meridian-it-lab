{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["blast_radius_people", "blast_radius_removals", "approvals_over_n", "approvals_default", "reference_date", "month_start"],
  "properties": {
    "blast_radius_people": {"type": "integer", "minimum": 1},
    "blast_radius_removals": {"type": "integer", "minimum": 1},
    "approvals_over_n": {"type": "integer", "minimum": 1},
    "approvals_default": {"type": "integer", "minimum": 1},
    "reference_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "month_start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
