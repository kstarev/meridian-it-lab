{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["exceptions"],
  "properties": {
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["employee_id", "app", "reason", "approval", "expires"],
        "properties": {
          "employee_id": {"type": "string", "pattern": "^E[0-9]+$"},
          "app": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "approval": {"type": "string", "pattern": "\\S"},
          "expires": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
